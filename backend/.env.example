# ResumeFit AI Environment Configuration (Example Placeholders)
PROJECT_NAME="ResumeFit AI"
VERSION="1.0.0"
DEBUG=false
API_V1_STR="/api"

# Security (Replace with a cryptographically random secret in production)
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DB_PATH="resumefit.db"

# Job Finder & Live Providers (Optional overrides - zero paid API keys required)
JOB_DATA_MODE="live"
JOB_CACHE_TTL_SECONDS=900
GREENHOUSE_COMPANIES="gitlab,cloudflare,figma,inmobi,groww,canonical"
LEVER_COMPANIES="palantir,wealthfront,cred"
ASHBY_COMPANIES="openai,linear,ramp,sentry,replit,notion"
PUBLIC_FEED_ENABLED=true
